# Claude (your group's key; never commit the real one)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Postgres from Supabase or Neon (pgvector is enabled automatically by the app)
# Supabase: Project settings > Database > Connection string (use the pooler URI, port 6543 or 5432)
# Neon: Dashboard > Connection string (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional: better fact-check sources (free tier at tavily.com). Without it, Wikipedia is used.
TAVILY_API_KEY=

# Public URLs
SITE_URL=https://your-rankforge.vercel.app
API_PUBLIC_URL=https://your-hf-username-rankforge-api.hf.space

# Random string used to sign dashboard login tokens
AUTH_SECRET=change-me-to-a-long-random-string

# Cost controls (USD per million tokens; set to the published claude-haiku-5-5 price)
PRICE_IN_PER_MTOK=1.0
PRICE_OUT_PER_MTOK=5.0
PER_USER_SPEND_CAP_USD=0.30
ARTICLE_MAX_TOKENS=1600
CHAT_MAX_TOKENS=600
